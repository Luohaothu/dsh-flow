.artifacts/
# The built bundle at the repository root only. An unanchored `lib/` would also
# match any source directory named `lib/` at any depth (the host modules the
# runner imports now live in `src/host/`), and they would be silently never
# committed.
/lib/

# Build output of the published plugin package. The vendored protocol face under
# packages/typert-protocol/lib is committed on purpose: it is the generated
# declaration surface the Typert generator has to recognize, and nothing
# regenerates it here.
/packages/dsh-flow/lib/
/packages/typert-protocol/lib/.tsbuild/

# Incremental TypeScript caches are regenerated by the build.
*.tsbuildinfo
