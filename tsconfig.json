{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "ESNext.Disposable"
    ],
    "jsx": "react-jsx",
    "paths": {
      "dsh-flow/native/protocol": [
        "./packages/dsh-flow/src/native/protocol.ts"
      ]
    }
  },
  "include": [
    "packages/dsh-flow/src/index.ts",
    "packages/dsh-flow/src/core/**/*.ts",
    "packages/dsh-flow/src/host/**/*.ts",
    "tests/contracts/**/*.ts",
    "tests/helpers/contract-*.ts",
    "scripts/build.ts",
    "packages/dsh-flow/src/run/**/*.ts",
    "packages/dsh-flow/src/assignments/**/*.ts",
    "scripts/verify-result-schema.ts",
    "packages/dsh-flow/src/patterns/**/*.ts",
    "scripts/verify-pattern-package.ts",
    "packages/dsh-flow/src/dashboard/**/*.ts",
    "packages/dsh-flow/src/native/**/*.ts",
    "tests/helpers/dashboard-fixture.ts"
  ],
  "exclude": [
    "tests/contracts/ui/**",
    "tests/contracts/native-client/**"
  ]
}
