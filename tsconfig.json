{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "ESNext.Disposable"
    ]
  },
  "include": [
    "packages/dsh-flow/src/index.ts",
    "packages/dsh-flow/src/core/**/*.ts",
    "packages/dsh-flow/src/host/**/*.ts",
    "tests/contracts/**/*.ts",
    "tests/helpers/contract-*.ts",
    "scripts/build.ts",
    "packages/dsh-flow/src/run/**/*.ts",
    "packages/dsh-flow/src/assignments/**/*.ts",
    "scripts/verify-result-schema.ts"
  ]
}
