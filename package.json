{
  "name": "dsh-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hierarchical agent cluster for the DeepSeek Harness: management-tree roles, durable transactions, recovery and layered budgets.",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "link:dsh": "node scripts/link-dsh.mjs",
    "test": "node --test tests/unit/*.test.js tests/acceptance/test/*.test.mjs",
    "test:qwen": "node tests/acceptance/qwen-smoke.mjs",
    "accept": "node tests/acceptance/run.mjs",
    "accept:mock": "node tests/acceptance/run.mjs --mock",
    "test:mock": "node --test --test-concurrency=1 tests/acceptance/native/*.test.mjs && node tests/acceptance/suite.mjs --mock"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tool-bash": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-jobs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.1.7-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
