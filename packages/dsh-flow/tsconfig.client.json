{
  // Client leaf: the plugin's browser half. It consumes the Host DTOs through
  // `./types` and the generated Remote declarations through `./remote`, and it
  // never imports the Host entry, so the two Context merges stay apart.
  // `rewriteRelativeImportExtensions` is on so the emitted module graph keeps
  // its explicit `.js` specifiers for the CJS factory bundle.
  "extends": "../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo"
  },
  "files": [
    "src/client.ts",
    "src/client/communication.tsx",
    "src/messages.ts",
    "src/client/team-view.tsx",
    "src/client/observer.ts",
    "src/client/agent-session.ts",
    "src/client/tree.ts",
    "src/client/preferences.ts",
    "src/client/navigation.ts",
    "src/client/reader.tsx",
    "src/client/reader-source.ts",
    "src/client/surfaces.tsx",
    "src/client/settings.tsx",
    "src/client/execution-settings.ts",
    "src/client/sidebar.tsx",
    "src/client/model-logo.tsx",
    "src/client/assets.d.ts",
    "src/identity.ts",
    "src/client/styles.ts",
    "src/errors.ts",
    "src/types.ts",
    "src/validation.ts"
  ]
}
