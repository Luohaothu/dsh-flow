{
  "name": "dsh-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "description": "Flow orchestration, persistent teams, assignments and DSH integration.",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/types/core/index.d.ts",
      "default": "./lib/core/index.js"
    },
    "./host": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./package.json": "./package.json",
    "./run": {
      "types": "./lib/types/run/index.d.ts",
      "default": "./lib/run/index.js"
    },
    "./assignments": {
      "types": "./lib/types/assignments/index.d.ts",
      "default": "./lib/assignments/index.js"
    },
    "./patterns": {
      "types": "./lib/types/patterns/index.d.ts",
      "default": "./lib/patterns/index.js"
    },
    "./dashboard": {
      "types": "./lib/types/dashboard/index.d.ts",
      "default": "./lib/dashboard/index.js"
    },
    "./dashboard/client": {
      "types": "./lib/types/dashboard/client.d.ts",
      "default": "./lib/dashboard/client.js"
    },
    "./dashboard/protocol": {
      "types": "./lib/types/dashboard/protocol.d.ts",
      "default": "./lib/dashboard/protocol.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "patterns",
    "skills"
  ],
  "scripts": {
    "prepack": "pnpm --dir ../.. run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
