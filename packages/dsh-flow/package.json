      "types": "./lib/types/dashboard/client.d.ts",
      "default": "./lib/dashboard/client.js"
    },
    "./dashboard/protocol": {
      "types": "./lib/types/dashboard/protocol.d.ts",
      "default": "./lib/dashboard/protocol.js"
    },
    "./native": {
      "types": "./lib/types/native/index.d.ts",
      "default": "./lib/native/index.js"
    },
    "./native/protocol": {
      "types": "./lib/types/native/protocol.d.ts",
      "default": "./lib/native/protocol.js"
    },
    "./ui": {
      "types": "./lib/types/ui/index.d.ts",
      "default": "./lib/ui/index.js"
    },
    "./client": {
      "types": "./lib/types/native/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "patterns",
    "skills",
    "web",
    "cordis.patch.yml"
